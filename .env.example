# Sao chép thành .env (scripts/install.sh tự tạo). KHÔNG commit file .env.

# Tên miền phụ chạy hệ thống mới, ví dụ beta.tenmiencu.com
DOMAIN=beta.example.com

# Cổng nội bộ trên VPS (chỉ 127.0.0.1). Hệ thống cũ dùng 5000, đừng trùng.
APP_PORT=8090

# Mật khẩu PostgreSQL (install.sh sinh ngẫu nhiên)
POSTGRES_PASSWORD=change-me

# Tài khoản quản trị tạo lần đầu (chỉ tạo khi chưa có tên này; đổi sau không đổi mật khẩu cũ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# true khi đã có HTTPS (certbot). Để false nếu đang chạy http, nếu không sẽ không đăng nhập được.
COOKIE_SECURE=false

# Giới hạn dung lượng mỗi ảnh tải lên (MB)
MAX_UPLOAD_MB=15

# Giới hạn dung lượng mỗi video admin tải lên (MB). Nginx (install.sh) cho tối đa 2100 MB.
MAX_VIDEO_MB=2048

# IP/dải mạng của reverse proxy được phép gắn X-Forwarded-For (cách nhau dấu phẩy).
# Để trống = 127.0.0.1, ::1 và các dải mạng nội bộ (Nginx trên VPS vào qua Docker bridge).
# Đừng đặt "*" — người ngoài sẽ giả mạo IP để vượt giới hạn đăng nhập.
TRUST_PROXY=
