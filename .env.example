# Sao chép thành .env (scripts/install.sh tự tạo). KHÔNG commit file .env.

# Tên miền phụ chạy hệ thống mới, ví dụ beta.tenmiencu.com
DOMAIN=beta.example.com

# Cổng nội bộ trên VPS (chỉ 127.0.0.1). Hệ thống cũ dùng 5000, đừng trùng.
APP_PORT=8090

# Mật khẩu PostgreSQL (install.sh sinh ngẫu nhiên)
POSTGRES_PASSWORD=change-me

# Tài khoản quản trị tạo lần đầu (chỉ tạo khi chưa có tên này; đổi sau không đổi mật khẩu cũ)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# true khi đã có HTTPS (certbot). Để false nếu đang chạy http, nếu không sẽ không đăng nhập được.
COOKIE_SECURE=false

# Giới hạn dung lượng mỗi ảnh tải lên (MB)
MAX_UPLOAD_MB=15

# Giới hạn dung lượng mỗi video admin tải lên (MB). Nginx (install.sh) cho tối đa 2100 MB.
MAX_VIDEO_MB=2048

# IP/dải mạng của reverse proxy được phép gắn X-Forwarded-For (cách nhau dấu phẩy).
# Để trống = 127.0.0.1, ::1 và các dải mạng nội bộ (Nginx trên VPS vào qua Docker bridge).
# Đừng đặt "*" — người ngoài sẽ giả mạo IP để vượt giới hạn đăng nhập.
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Telegram Bridge (dịch vụ bot riêng — thư mục bot/)
# ---------------------------------------------------------------------------

# Khoá dịch vụ chung giữa web và bot. Dài, ngẫu nhiên. KHÔNG commit.
# Sinh bằng: openssl rand -hex 32
BOT_API_SECRET=

# Cổng của endpoint nội bộ xác minh initData (chỉ bind 127.0.0.1).
BOT_INTERNAL_PORT=8091

# Token bot Telegram. Nhiều bot, cách nhau bằng dấu phẩy: <id>:<token>,<id>:<token>
# Token chỉ nằm ở service bot, KHÔNG đặt trong web.
TELEGRAM_BOT_TOKENS=

# Khoá mã hoá token bot lưu trong CSDL (AES-256-GCM). Bắt buộc khi muốn thêm bot
# từ trang quản trị. Dài, ngẫu nhiên. KHÔNG commit.
# Sinh bằng: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# Cho phép khôi phục cơ sở dữ liệu từ trang quản trị (mặc định tắt an toàn).
# Chỉ bật khi đang thao tác, tắt lại sau khi khôi phục xong.
ALLOW_RESTORE=0

# URL công khai của website (dùng để dựng link trong tin nhắn Telegram).
SITE_URL=https://beta.example.com

# Chat id Telegram nhận cảnh báo vận hành (tuỳ chọn).
ADMIN_CHAT_ID=
