# Copy to .env (scripts/install.sh does this for you) and fill in the values.

# Domain pointing at this VPS (DNS A record). Caddy obtains HTTPS for it automatically.
DOMAIN=admin.example.com
# Optional: public URL if different from https://DOMAIN
PUBLIC_URL=

# Random 64-char hex: openssl rand -hex 32
SECRET_KEY=

# First owner account, created only when the admins table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

POSTGRES_DB=chongtoico
POSTGRES_USER=chongtoico
# Random: openssl rand -hex 24
POSTGRES_PASSWORD=

# Set to false only for local HTTP testing.
COOKIE_SECURE=true
